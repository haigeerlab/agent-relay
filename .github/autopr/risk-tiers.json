{
  "extends": "plugin",
  "$comment": "Read by autopilot-hub admission (risk/tiers.py) from the base branch. Same paths as risk-tiers.yml (kept for when the hub reads YAML again); change both together. Editing this file is T4.",
  "T4": [
    ".claude-plugin/**",
    "plugins/agent-relay/.claude-plugin/**",
    "plugins/agent-relay/.codex-plugin/**",
    "plugins/agent-relay/interface.json",
    "plugins/agent-relay/bridge/UPSTREAM.sha256",
    "plugins/agent-relay/bridge/UPSTREAM.md",
    "plugins/agent-relay/bridge/LICENSE",
    "plugins/agent-relay/bridge/package.json",
    "plugins/agent-relay/bridge/package-lock.json",
    "plugins/agent-relay/bridge/src/version.ts",
    "scripts/validate.sh",
    "scripts/ci_scope.py",
    "scripts/bridge-manifest.py",
    "RELEASING.md",
    "LICENSE"
  ],
  "T3": [
    "CLAUDE.md",
    "AGENTS.md",
    "plugins/agent-relay/bridge/src/**",
    "plugins/agent-relay/bridge/scripts/build.mjs",
    "plugins/agent-relay/bridge/tsconfig.json",
    "plugins/agent-relay/hooks/native_collaboration_runtime.py",
    "plugins/agent-relay/hooks/native_collaboration_adapters.py",
    "plugins/agent-relay/hooks/native_collaboration_retire.py",
    "plugins/agent-relay/hooks/host_backup.py",
    "plugins/agent-relay/hooks/host_config_removal.py",
    "plugins/agent-relay/hooks/state_migration.py",
    "plugins/agent-relay/hooks/delegation_scope_hook.py",
    "plugins/agent-relay/hooks/defect_guard.py",
    "docs/collaboration-interface.md",
    "SECURITY.md"
  ],
  "T2": [
    "plugins/agent-relay/commands/**",
    "plugins/agent-relay/skills/**",
    "plugins/agent-relay/references/**",
    "scripts/acceptance/**"
  ],
  "T1": [
    "plugins/agent-relay/hooks/test_*.py",
    "plugins/agent-relay/bridge/test/**",
    "plugins/agent-relay/bridge/tsconfig.test.json"
  ]
}
