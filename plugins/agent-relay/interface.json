{
  "interface": "2.13",
  "status": [
    "python3",
    "-B",
    "hooks/relay_status.py"
  ],
  "script": {
    "agents": [
      "~/.agent-relay/bin/agent-relay",
      "agents"
    ],
    "outbox": [
      "~/.agent-relay/bin/agent-relay",
      "outbox",
      "<agent>"
    ],
    "sessions": [
      "~/.agent-relay/bin/agent-relay",
      "sessions"
    ],
    "send": [
      "~/.agent-relay/bin/agent-relay",
      "send",
      "--from",
      "<script identity>",
      "--to",
      "<agent>"
    ],
    "inbox": [
      "~/.agent-relay/bin/agent-relay",
      "inbox",
      "<script identity>"
    ],
    "ack": [
      "~/.agent-relay/bin/agent-relay",
      "ack",
      "<script identity>",
      "--ids",
      "<ids>"
    ]
  }
}
