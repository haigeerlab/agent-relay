{
  "interface": "2.10",
  "status": [
    "python3",
    "-B",
    "hooks/relay_status.py"
  ],
  "script": {
    "agents": [
      "~/.agent-relay/bin/agent-relay",
      "agents"
    ],
    "outbox": [
      "~/.agent-relay/bin/agent-relay",
      "outbox",
      "<agent>"
    ],
    "sessions": [
      "~/.agent-relay/bin/agent-relay",
      "sessions"
    ],
    "send": [
      "~/.agent-relay/bin/agent-relay",
      "send",
      "--from",
      "<script identity>",
      "--to",
      "<agent>"
    ]
  }
}
